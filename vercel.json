{
  "functions": {
    "api/index.py": {
      "includeFiles": "{server.py,main.py,sample_resume.pdf,public/**,index.html,styles.css,script.js}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
